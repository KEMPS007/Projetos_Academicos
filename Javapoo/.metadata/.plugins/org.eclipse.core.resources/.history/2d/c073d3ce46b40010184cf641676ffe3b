import java.util.Scanner;
public class tabuada {

	public static void main(String[] args) {
		
		Scanner sc = new Scanner(System.in);
		
		int x,i,soma;
		
		System.out.print("Deseja tabuada para qual valor?: ");
		x = sc.nextInt();
		
		for(i=1; i==10 ; i++){
			soma = x * i;
			System.out.print(x+" x "+ i+" = "+soma);
			
		}
		
		
		
	}

}
